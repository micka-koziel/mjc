{
  "name": "quantique-email",
  "version": "0.1.0",
  "private": true,
  "description": "Quantique — package générique de gestion des e-mails (extrait de Trendl)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "config:validate": "node scripts/config-cli.mjs validate",
    "config:apply": "node scripts/config-cli.mjs apply",
    "config:reset": "node scripts/config-cli.mjs reset",
    "questionnaire:build": "node scripts/build-questionnaire.mjs",
    "check:no-crm": "node scripts/check-no-crm.mjs",
    "test:functions": "vitest run --config vitest.config.functions.mjs"
  },
  "dependencies": {
    "firebase": "12.15.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.1",
    "tailwindcss": "4.3.1",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
