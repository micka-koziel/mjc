# Variables des Cloud Functions Quantique (copier vers functions/.env).
# Aucun secret ici : les secrets vont dans Google Secret Manager (voir README).

# Personnes autorisées (en plus du document Firestore app_settings/access,
# champ allowed_emails, qui est la liste de référence — voir README).
ALLOWED_EMAILS=

# Adresse(s) web de l'application autorisées à appeler les fonctions (virgules).
# Ex. https://mon-instance.netlify.app  (http://localhost:3000 est toujours autorisé)
ALLOWED_ORIGINS=

# OAuth Gmail : identifiant client (Google Cloud > APIs > Identifiants).
GMAIL_CLIENT_ID=
# URL de la fonction callbackOAuth (connue après le 1er déploiement) :
# https://europe-west1-<PROJECT_ID>.cloudfunctions.net/callbackOAuth
GMAIL_REDIRECT_URI=

# Nom du sujet Pub/Sub recevant les notifications Gmail (à créer, voir README).
GMAIL_PUBSUB_TOPIC_NAME=quantique-emails-inbound

# Facultatif : marqueur d'objet des e-mails de formulaire de contact du site
# (on répond alors à l'adresse saisie dans le formulaire).
CONTACT_SUBJECT_MARKER=[Contact]

# Facultatif : prénoms de signature à remplacer par la signature de l'expéditeur.
DEFAULT_SIGNERS=

# Sorties IA strictes (repris de Trendl, désactivé par défaut).
ANTHROPIC_STRICT_OUTPUTS=false

# Facultatif : supervision des erreurs (Sentry).
SENTRY_DSN=

# --- Secrets (Secret Manager) ---
# ANTHROPIC_API_KEY    clé API Anthropic
# GMAIL_CLIENT_SECRET  secret du client OAuth Google
# GMAIL_REFRESH_TOKEN  créé automatiquement par callbackOAuth
# Domaine(s) de messagerie de l'entreprise, jamais mis en copie automatiquement (virgules).
INTERNAL_DOMAINS=
